---
type Cert = {
  ic: string;
  short: string;
  full: string;
  desc: string;
};

const CERTS: Cert[] = [
  {
    ic: 'shield-check',
    short: 'IAABC',
    full: 'Member · International Assoc. of Animal Behavior Consultants',
    desc: "The gold standard for behavior consultants — annual continuing education and a published case-study requirement.",
  },
  {
    ic: 'badge-check',
    short: 'ADT',
    full: 'Accredited Dog Trainer',
    desc: "Verified credential covering applied learning theory, ethics, and humane training methodology.",
  },
  {
    ic: 'brain',
    short: 'CBC',
    full: 'Canine Behavior Consultant',
    desc: "Specialization in fear, reactivity, and aggression cases — the work that needs the most patience.",
  },
  {
    ic: 'graduation-cap',
    short: 'AKC Evaluator',
    full: 'CGC · Puppy S.T.A.R. · Trick Titles',
    desc: "Authorized to test dogs for AKC's Canine Good Citizen and related life-skill certifications.",
  },
  {
    ic: 'sparkles',
    short: '+R Clicker',
    full: 'Positive Reinforcement & Clicker Training',
    desc: "Marker-based training for clean, fast communication — the foundation of force-free work.",
  },
  {
    ic: 'shield-alert',
    short: 'Fear & Aggression',
    full: 'Specialized Behavior Modification',
    desc: "Advanced coursework in counter-conditioning, threshold work, and BAT (Behavior Adjustment Training).",
  },
  {
    ic: 'first-aid',
    short: 'Pet First Aid',
    full: 'Certified Responder',
    desc: "Because the only acceptable answer when a dog needs help is to know exactly what to do.",
  },
  {
    ic: 'book-open',
    short: 'Continuing Ed',
    full: 'Ongoing study, every year',
    desc: "Behavior science doesn't sit still. Neither do I — annual workshops, conferences, and seminars are part of the job.",
  },
];
---

<section id="credentials" style="background:var(--cu-cream);position:relative;overflow:hidden;">
  <div class="container-wide" style="position:relative;z-index:1;">
    <div style="display:grid;grid-template-columns:1fr auto;align-items:end;gap:40px;margin-bottom:48px;">
      <div>
        <div class="eyebrow"><span class="tick"></span>Credentials · Receipts</div>
        <h2 class="section-title" style="max-width:680px;">
          The certifications I keep <span style="color:var(--cu-gold);">current.</span>
        </h2>
        <p class="section-lead">
          Anyone can call themselves a dog trainer. The training industry isn't
          regulated, and that's a problem. Here's what I actually study, test for,
          and renew — so you can verify the methods I use are backed up by something.
        </p>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:18px;">
      {CERTS.map((c) => (
        <article style="background:#fff;border:1px solid var(--border);border-radius:22px;padding:24px 22px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:14px;">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div style="width:44px;height:44px;border-radius:12px;background:var(--cu-gold);color:var(--cu-navy);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i data-lucide={c.ic} style="width:22px;height:22px;"></i>
            </div>
            <div style="font:900 13px var(--font-sans);color:var(--cu-gold);letter-spacing:0.16em;text-transform:uppercase;text-align:right;">
              {c.short}
            </div>
          </div>
          <div>
            <div style="font:800 14px var(--font-sans);color:var(--cu-navy);line-height:1.35;margin-bottom:8px;">
              {c.full}
            </div>
            <div style="font:500 13px var(--font-sans);color:var(--fg2);line-height:1.55;">
              {c.desc}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
