---
type Cert = {
  badge: string;
  alt: string;
  short: string;
  full: string;
};

// Visual cert badges — same set displayed on the live canine-u.com site.
const CERTS: Cert[] = [
  {
    badge: 'cert-iaabc.png',
    alt: 'IAABC Member Accredited badge',
    short: 'IAABC',
    full: 'Accredited Member · International Assoc. of Animal Behavior Consultants',
  },
  {
    badge: 'cert-adt.jpg',
    alt: 'ADT Accredited Dog Trainer — Brianna Alamo',
    short: 'ADT',
    full: 'Accredited Dog Trainer · issued in my name',
  },
  {
    badge: 'cert-cbc.png',
    alt: 'Canine Behavior Consultant certificate',
    short: 'CBC',
    full: 'Canine Behavior Consultant · fear, reactivity, aggression cases',
  },
  {
    badge: 'cert-akc-cgc.png',
    alt: 'AKC Canine Good Citizen evaluator badge',
    short: 'AKC CGC',
    full: 'Canine Good Citizen Evaluator',
  },
  {
    badge: 'cert-akc-star-puppy.png',
    alt: 'AKC S.T.A.R. Puppy evaluator badge',
    short: 'AKC S.T.A.R.',
    full: 'S.T.A.R. Puppy Evaluator · ages 8 weeks to 1 year',
  },
  {
    badge: 'cert-akc-community-canine.png',
    alt: 'AKC Community Canine evaluator badge',
    short: 'AKC Community Canine',
    full: 'Advanced CGC · real-world manners',
  },
  {
    badge: 'cert-akc-urban-cgc.png',
    alt: 'AKC Urban CGC evaluator badge',
    short: 'AKC Urban CGC',
    full: 'Urban CGC Evaluator · busy real-world environments',
  },
];

const TEXT_CERTS = [
  '+R Clicker Training',
  'Fear & Aggression Methodology',
  'BAT (Behavior Adjustment Training)',
  'Pet First Aid Certified',
  'Basic Training Theory',
];
---

<section id="credentials" style="background:var(--cu-cream);position:relative;overflow:hidden;">
  <div class="container-wide" style="position:relative;z-index:1;">
    <div style="max-width:760px;margin-bottom:48px;">
      <div class="eyebrow"><span class="tick"></span>Credentials · The receipts</div>
      <h2 class="section-title">
        The certifications I keep <span style="color:var(--cu-gold);">current.</span>
      </h2>
      <p class="section-lead">
        Anyone can call themselves a dog trainer. The industry isn't regulated,
        and that's a real problem. Here's what I actually study, test for, and
        renew — so you can verify the methods I use are backed up by something.
      </p>
    </div>

    <!-- Real badge grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:20px;margin-bottom:36px;">
      {CERTS.map((c) => (
        <article style="background:#fff;border:1px solid var(--border);border-radius:24px;padding:30px 24px 26px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;">
          <div style="width:100%;height:140px;display:flex;align-items:center;justify-content:center;">
            <img
              src={`/assets/${c.badge}`}
              alt={c.alt}
              loading="lazy"
              style="max-width:130px;max-height:130px;width:auto;height:auto;object-fit:contain;"
            />
          </div>
          <div>
            <div style="font:900 13px var(--font-sans);color:var(--cu-gold);letter-spacing:0.16em;text-transform:uppercase;margin-bottom:8px;">
              {c.short}
            </div>
            <div style="font:700 14px var(--font-sans);color:var(--cu-navy);line-height:1.4;">
              {c.full}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Text-only supplementary certs -->
    <div style="background:#fff;border:1px dashed var(--border-strong);border-radius:24px;padding:24px 28px;display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px;">
      <div style="font:800 11px var(--font-sans);color:var(--fg3);letter-spacing:0.18em;text-transform:uppercase;flex-shrink:0;">
        Plus, certified in:
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:8px;">
        {TEXT_CERTS.map((t) => (
          <span class="chip">
            <i data-lucide="check" style="width:14px;height:14px;color:var(--cu-gold);"></i>
            {t}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
