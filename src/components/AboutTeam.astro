---
type Member = {
  name: string;
  role: string;
  img: string;
  pronouns: string;
  bio: string;
  bullets: string[];
};

const TEAM: Member[] = [
  {
    name: 'Brianna Alamo',
    role: 'Owner & Lead Trainer',
    img: 'brianna.jpg',
    pronouns: 'she/her',
    bio: "I take every Board & Train and Behavior Modification case personally — those are the ones that need the most consistency from session to session. I'm also your point of contact from your first inquiry through graduation, and I'm the one writing your follow-up plan.",
    bullets: [
      '10+ years training in South Florida',
      'IAABC, ADT, CBC certified',
      'Specialty: reactivity, fear, board & train',
    ],
  },
  {
    name: 'Jayden Garcia',
    role: 'Junior Trainer',
    img: 'jayden.jpg',
    pronouns: 'he/him',
    bio: "Jayden helps me on Day School, Puppy Foundations, and select Private Lessons — the cohort and group-friendly work where a second pair of hands and eyes makes the day better for everyone. He's been training under me for two years and uses the same force-free approach.",
    bullets: [
      'Force-free trained under Brianna',
      'Day School & Puppy Foundations lead',
      'Trick training & enrichment specialist',
    ],
  },
];
---

<section id="team" style="background:var(--cu-bone);position:relative;overflow:hidden;">
  <div class="paws faint"></div>
  <div class="container-wide" style="position:relative;z-index:1;">
    <div style="max-width:760px;margin-bottom:56px;">
      <div class="eyebrow"><span class="tick"></span>Team · Two trainers, one approach</div>
      <h2 class="section-title">
        The people you'll <span style="color:var(--cu-gold);">actually meet.</span>
      </h2>
      <p class="section-lead">
        Small on purpose. You'll never get bounced between trainers, never
        get a new name on session three, never have to re-explain your dog's
        history to a stranger.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px;">
      {TEAM.map((m) => (
        <article class="hover-lift" style="background:#fff;border:1px solid var(--border);border-radius:28px;overflow:hidden;box-shadow:var(--shadow-md);display:flex;flex-direction:column;">
          <div style="position:relative;aspect-ratio:5/4;overflow:hidden;background:var(--cu-bone);">
            <img src={`/assets/${m.img}`} alt={m.name} style="width:100%;height:100%;object-fit:cover;" />
            <div style="position:absolute;top:18px;left:18px;background:var(--cu-gold);color:var(--cu-navy);font:900 11px var(--font-sans);letter-spacing:0.16em;text-transform:uppercase;padding:6px 12px;border-radius:9999px;">
              {m.role}
            </div>
          </div>

          <div style="padding:30px 30px 32px;display:flex;flex-direction:column;flex:1;">
            <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:16px;">
              <h3 style="margin:0;font:900 28px var(--font-display);color:var(--cu-navy);letter-spacing:-0.01em;text-transform:uppercase;line-height:1;">
                {m.name}
              </h3>
              <span style="font:500 12px var(--font-sans);color:var(--fg3);letter-spacing:0.04em;">
                ({m.pronouns})
              </span>
            </div>

            <p style="margin:0 0 22px;color:var(--fg2);font:500 15px var(--font-sans);line-height:1.65;flex:1;">
              {m.bio}
            </p>

            <ul style="list-style:none;padding:18px 0 0;margin:0;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px;">
              {m.bullets.map((b) => (
                <li style="display:flex;gap:10px;align-items:center;font:600 13px var(--font-sans);color:var(--cu-navy);">
                  <i data-lucide="check" style="width:16px;height:16px;color:var(--cu-gold);flex-shrink:0;"></i>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
