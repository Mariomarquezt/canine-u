---
---

<section style="padding:52px 0;background:#fff;border-bottom:1px solid var(--border);">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:40px;flex-wrap:wrap;">
      <div class="num-tag">As featured & accredited</div>
      <div style="display:flex;align-items:center;gap:48px;flex-wrap:wrap;opacity:0.85;">
        <img src="/assets/badge-iaabc.png" alt="IAABC certified" style="height:54px;object-fit:contain;" />
        <img src="/assets/badge-akc.png" alt="AKC evaluator" style="height:54px;object-fit:contain;" />
        <div style="display:flex;align-items:center;gap:10px;font:800 17px var(--font-sans);color:var(--cu-navy);">
          <i data-lucide="shield-check" style="width:24px;height:24px;color:var(--cu-gold);"></i>
          Fully Insured & Bonded
        </div>
        <div style="display:flex;align-items:center;gap:10px;font:800 17px var(--font-sans);color:var(--cu-navy);">
          <i data-lucide="heart" style="width:24px;height:24px;color:var(--cu-orange);"></i>
          Force-Free, Reward-Based
        </div>
      </div>
    </div>
  </div>
</section>
