---
---

<section style="position:relative;padding:150px 0 80px;background:var(--cu-cream);overflow:hidden;">
  <div class="paws faint"></div>

  <!-- Decorative gold blob -->
  <div style="position:absolute;top:120px;right:-60px;width:280px;height:280px;background:radial-gradient(circle, rgba(255,199,0,0.18), transparent 65%);border-radius:50%;filter:blur(20px);pointer-events:none;"></div>

  <div class="container-wide" style="position:relative;z-index:2;">
    <div style="max-width:780px;margin:0 auto;text-align:center;">
      <div class="eyebrow" style="justify-content:center;">
        <span class="tick"></span>Office Hours · Get in touch
      </div>

      <h1 class="display-title" style="margin-bottom:24px;">
        Tell me about <span class="scribble"><span style="position:relative;z-index:1;">your dog.</span></span>
      </h1>

      <p style="font-size:19px;line-height:1.65;color:var(--fg2);font-weight:500;max-width:620px;margin:0 auto 36px;">
        Whether you're stuck on something specific or just figuring out where to start —
        I want to hear what's going on. Free 20-minute Meet &amp; Greet for everyone, no
        pressure to book afterward.
      </p>

      <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;align-items:center;">
        <a href="#contact" class="btn btn-navy btn-lg">
          Go to the form
          <i data-lucide="arrow-down" style="width:18px;height:18px;"></i>
        </a>
        <a href="tel:9542688899" class="btn btn-ghost btn-lg">
          <i data-lucide="phone" style="width:16px;height:16px;"></i>
          Call 954-268-8899
        </a>
      </div>

      <div style="margin-top:40px;display:inline-flex;align-items:center;gap:10px;font:500 14px var(--font-sans);color:var(--fg3);">
        <span style="width:8px;height:8px;border-radius:50%;background:#62D58A;box-shadow:0 0 0 4px rgba(98,213,138,0.2);"></span>
        Replies within 24 hours · Mon–Sat · 8a–7p
      </div>
    </div>
  </div>
</section>
